# ─── Database ────────────────────────────────────────────────────────
# PostgreSQL connection string.
# When running via docker-compose, this points at the bundled db service.
# For local dev against your own Postgres, set your own host/creds.
DATABASE_URL=postgresql://actionbom:actionbom@localhost:5432/actionbom

# ─── GitHub API ──────────────────────────────────────────────────────
# Personal access token or fine-grained token with `repo` (read) scope.
# Required for scanning private repos and to lift API rate limit from
# 60/hr (unauthenticated) to 5000/hr.
GITHUB_TOKEN=

# The GitHub org to scan. On first boot, if this is set and the
# repositories table is empty, the app will bulk-import all repos from
# this org. Leave blank to bring your own repositories list.
TARGET_ORG=

# ─── Cron / batch scanning ───────────────────────────────────────────
# Enable the background scanner. Set to "false" to run API-only.
CRON_ENABLED=true

# Standard 5-field cron expression (UTC). Default: every 30 minutes —
# fine for small/mid orgs (~50 repos). Bump to "0 */3 * * *" or slower
# for orgs with >1000 repos to avoid hammering the GitHub API.
CRON_SCHEDULE=*/30 * * * *

# How many repos to scan per cron tick. Sized for small/mid orgs.
# Bump higher for larger orgs (each repo costs ~1-5 GitHub API calls).
BATCH_SIZE=50

# Skip the run entirely if fewer than this many GitHub API requests
# remain in the current hour. Prevents blowing through the rate limit
# mid-batch.
RATE_LIMIT_THRESHOLD=500

# ─── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Slack alerts (optional) ─────────────────────────────────────────
# Incoming webhook URL. Leave blank to disable Slack notifications.
# When set, the scanner posts alerts for new CRITICAL SCA findings and
# new template-injection SAST findings.
SLACK_WEBHOOK_URL=

# Public URL of this dashboard, used in Slack alert links.
DASHBOARD_BASE_URL=http://localhost:8000

# Optional Slack user ID to cc on template-injection alerts
# Leave blank to skip the cc line entirely.
SLACK_CC_USER_ID=
